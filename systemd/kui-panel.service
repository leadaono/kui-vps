[Unit]
Description=KUI VPS Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kui
Group=kui
WorkingDirectory=/opt/kui-vps
EnvironmentFile=/etc/kui-vps/kui-panel.env
ExecStart=/usr/bin/node /opt/kui-vps/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kui-vps

[Install]
WantedBy=multi-user.target
